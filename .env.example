# Vercel AI Gateway API key. Required server-side for /api/ais.
# Get a key at https://vercel.com/dashboard → AI → API Keys.
# In Vercel production, set this in the project's Environment Variables.
AI_GATEWAY_API_KEY=

# Optional: override the model the AIS terminal uses.
# See https://vercel.com/docs/ai-gateway/models for the list.
# AIS_MODEL=openai/gpt-4o-mini
